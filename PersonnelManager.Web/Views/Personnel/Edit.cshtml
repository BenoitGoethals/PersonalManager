@model PersonInput
@{
    ViewData["Title"] = "Edit person";
}

<h1>Edit person</h1>

<form method="post" class="card">
    <div asp-validation-summary="All" class="validation"></div>

    <div class="field">
        <label asp-for="Name"></label>
        <input asp-for="Name"/>
        <span asp-validation-for="Name" class="validation"></span>
    </div>
    <div class="field">
        <label asp-for="Surname"></label>
        <input asp-for="Surname"/>
        <span asp-validation-for="Surname" class="validation"></span>
    </div>
    <div class="field">
        <label asp-for="Address"></label>
        <input asp-for="Address"/>
        <span asp-validation-for="Address" class="validation"></span>
    </div>
    <div class="field">
        <label asp-for="Phone"></label>
        <input asp-for="Phone"/>
        <span asp-validation-for="Phone" class="validation"></span>
    </div>
    <div class="field">
        <label asp-for="Status"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<EmploymentStatus>()"></select>
    </div>

    <div class="actions">
        <button type="submit" class="btn">Save</button>
        <a class="btn secondary" asp-action="Index">Cancel</a>
    </div>
</form>
