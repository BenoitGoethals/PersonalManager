@model PersonnelIndexViewModel
@{
    ViewData["Title"] = "People";
}

<h1>People</h1>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="get" class="toolbar">
    <div class="field">
        <label for="Name">Search name</label>
        <input id="Name" name="Name" value="@Model.Name" placeholder="name or surname"/>
    </div>
    <div class="field">
        <label for="Status">Status</label>
        <select id="Status" name="Status" asp-items="Html.GetEnumSelectList<EmploymentStatus>()">
            <option value="">(any)</option>
        </select>
    </div>
    <button type="submit" class="btn secondary">Filter</button>
    <a class="btn secondary" asp-action="Index">Reset</a>
    <div class="spacer" style="flex:1"></div>
    <a class="btn" asp-action="Create">+ New person</a>
</form>

<table>
    <thead>
    <tr>
        <th>Name</th>
        <th>Surname</th>
        <th>Phone</th>
        <th>Status</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @if (Model.People.Count == 0)
    {
        <tr>
            <td colspan="5" class="muted">No people found.</td>
        </tr>
    }
    @foreach (var person in Model.People)
    {
        <tr>
            <td>@person.Name</td>
            <td>@person.Surname</td>
            <td>@person.Phone</td>
            <td><span class="badge">@person.Status</span></td>
            <td class="actions">
                <a class="btn secondary" asp-action="Edit" asp-route-id="@person.Id">Edit</a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="btn danger" asp-action="Delete" asp-route-id="@person.Id">Delete</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@if (User.IsInRole("Admin"))
{
    <form method="post" asp-action="Backup" style="margin-top:1rem">
        <button type="submit" class="btn secondary">Back up to JSON</button>
    </form>
}
