@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Personnel Manager</title>
    <link rel="stylesheet" href="~/css/site.css"/>
</head>
<body>
<header>
    <nav class="nav">
        <a class="brand" asp-page="/Personnel/Index">Personnel Manager</a>
        <div class="spacer"></div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-page="/Personnel/Index">People</a>
            <span class="who">@User.Identity!.Name @(User.IsInRole("Admin") ? "(Admin)" : "")</span>
            <form method="post" asp-page="/Account/Logout" class="inline">
                <button type="submit" class="link-btn">Log out</button>
            </form>
        }
        else
        {
            <a asp-page="/Account/Login">Log in</a>
        }
    </nav>
</header>
<main class="container">
    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }
    @RenderBody()
</main>
</body>
</html>
