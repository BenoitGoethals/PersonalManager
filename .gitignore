# ---------------------------------------------------------------------------
# .gitignore for the PersonnelManager solution (.NET 10 / C# 14)
# Covers: build output, IDE files (Rider/VS/VS Code), test/coverage output,
# NuGet, macOS/Windows cruft, and this solution's generated runtime artifacts.
# ---------------------------------------------------------------------------

# --- Build output ---
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]uild/
artifacts/
publish/
*.publishsettings

# --- Rider / JetBrains ---
.idea/
*.sln.iml
*.DotSettings.user

# --- Visual Studio ---
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# --- VS Code ---
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# --- Test & coverage output ---
[Tt]est[Rr]esults/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
.coverage/

# --- NuGet ---
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
.nuget/
project.lock.json
project.fragment.lock.json

# --- .NET tooling ---
*.received.*
msbuild.log
msbuild.binlog

# --- OS cruft ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------------------------------------------------------------------------
# Solution-specific runtime artifacts (generated by running the apps)
# ---------------------------------------------------------------------------

# LogAnalyzer generates sample/test log folders and files
sample-logs/
test-logs/
*.log

# PersonnelManager writes its store + log next to the executable (already under
# bin/, but ignore by name too in case an app is launched from the repo root)
personnel.json
personnel.log
